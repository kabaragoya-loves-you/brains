{
  "name": "brains",
  "version": "0.1.0",
  "description": "Brains! by Kabaragoya — a visualizer for the Neurosity Crown",
  "author": "Kabaragoya",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/build-renderer.js && node scripts/copy-static.js",
    "build:web": "node scripts/build-web.js",
    "build:web:only": "node scripts/build-web.js --skip-exe",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "watch": "npm run build && electron .",
    "dist:win": "npm run build && npm run build:web:only && node scripts/dist-win.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neurosity/sdk": "^7.5.1",
    "three": "^0.175.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/three": "^0.175.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "co.kabaragoya.brains",
    "productName": "Brains!",
    "copyright": "Copyright © 2026 Kabaragoya",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "assets/kabaragoya.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/kabaragoya.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Brains!"
    }
  }
}
